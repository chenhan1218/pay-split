# Gitignore for Split Payment App

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.yarn/

# Next.js specific
.next/
out/
.vercel/

# TypeScript
*.tsbuildinfo

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Editor/IDE specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temp files
*.tmp
*~

# For the 'web' subdirectory
web/node_modules/
web/.next/
web/out/